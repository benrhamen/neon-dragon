{
  "name": "neon-gamebook",
  "version": "2.1.0",
  "description": "Retro arcade gamebook reader prototype (static site)",
  "scripts": {
    "validate": "node tests/validate.mjs",
    "build": "node tests/validate.mjs",
    "test:engine": "node --test tests/engine.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "test": "npm run validate && npm run test:engine && npm run test:e2e",
    "serve": "python3 -m http.server 8080 --directory public",
    "score:ref": "node --max-old-space-size=6000 scripts/score-reference.mjs",
    "sim": "node -e \"import('./tests/sim.mjs').then(async m=>{const b=JSON.parse(require('fs').readFileSync('public/data/neon-dragon.json'));console.log(JSON.stringify(m.balanceReport(b,5000),null,1))})\""
  },
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "playwright": "^1.63.0"
  },
  "private": true,
  "type": "module"
}
